<?php

namespace {{ namespace }};

use {{ namespacedInputClass }};
use Illuminate\Contracts\JsonSchema\JsonSchema;
use Laravel\Mcp\Request;
use Laravel\Mcp\Response;
use Laravel\Mcp\ResponseFactory;
use Laravel\Mcp\Server\Attributes\Description;
use Laravel\Mcp\Server\Tool;
use Rushing\McpRegistry\Attributes\ToolAbility;
use Splicewire\Beam\Mcp\Attributes\McpTool;
use Splicewire\Beam\Mcp\Shapes\DerivesInputSchemaFromData;

/**
 * An MCP tool in the `{{ group }}` mount group, gated on the `{{ ability }}` ability. Every shape it exchanges is
 * declared before the body is written, which is the point of the generator:
 *
 *   - input:   {{ inputClass }}. DerivesInputSchemaFromData advertises its constructor as the tool's
 *              `inputSchema`, so this class writes no `schema()`: an override is what the MCP shape audit
 *              counts as a hand-authored input;
 *   - output:  `outputSchema()`, and `handle()` answers in exactly that shape through `Response::structured()`
 *              (sent as `structuredContent`, with the same object as JSON text). Change the two together; an
 *              inherited `outputSchema()` is the audit's other half;
 *   - ability: #[ToolAbility]. A server using AuthorizesTools lists and calls the tool only for a caller
 *              granted the ability.
 *
 * #[McpTool] declares the group; the host lists the class, in config/beam/mcp.php:
 *
 *     'classes' => [{{ class }}::class],
 */
#[Description('Describe what this tool does and when an agent should call it.')]
#[ToolAbility('{{ ability }}')]
#[McpTool('{{ group }}')]
class {{ class }} extends Tool
{
    use DerivesInputSchemaFromData;

    public function handle(Request $request): ResponseFactory
    {
        // The advertised input schema is the Data class; hydrate it and do the work.
        $input = {{ inputClass }}::from($request->all());

        // The object outputSchema() declares, key for key.
        return Response::structured([
            'result' => (string) $input->placeholder,
        ]);
    }

    protected function inputData(): string
    {
        return {{ inputClass }}::class;
    }

    /**
     * @return array<string, mixed>
     */
    public function outputSchema(JsonSchema $schema): array
    {
        return [
            'result' => $schema->string()
                ->description('Describe what handle() returns.')
                ->required(),
        ];
    }
}
