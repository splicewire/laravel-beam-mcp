{
    "name": "splicewire/laravel-beam-mcp",
    "description": "The MCP arm of the schemastud beam family: any beam-tier package exposes an MCP tool by annotating the tool class #[McpTool('group')] \u2014 no Tower-side edit required. Ships the attribute-scan McpToolManifest registry (grouped tool-class discovery, self-described into beam-core's ManifestIndex) that a host MCP server (e.g. Splicewire\\Tower\\Mcp\\Servers\\SplicewireServer) composes at boot, replacing a hand-maintained tool-class list.",
    "keywords": [
        "laravel",
        "schemastud",
        "beam",
        "mcp",
        "model-context-protocol",
        "attribute-scan"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/mcp": "^0.8",
        "rushing/laravel-mcp-registry": "dev-main",
        "rushing/laravel-popcorn": "dev-main",
        "rushing/php-popcorn": "dev-main",
        "spatie/laravel-data": "^4.0|^5.0",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-mdx": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Mcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Mcp\\BeamMcpServiceProvider"
            ]
        },
        "package-topology": {
            "because": "beam-mcp is the MCP arm of the beam family \u2014 it owns the attribute-scan tool-group registry (#[McpTool] \u2192 McpToolManifest) that lets any beam-tier package expose an MCP tool without a Tower-side edit. As a particle-adjacent CONSUMER it depends DOWN on base beam for the ManifestIndex self-description seam, and on laravel/mcp + rushing/laravel-mcp-registry for the ToolGroup/Tool vocabulary it composes into \u2014 a plain in-estate require, mustRequire. beam-mcp must NEVER reach UP into the tower / satellite tiers that consume it: the registry is POPULATED by beam-tier producers and READ by tower's SplicewireServer, never the reverse (no beam-mcp \u2192 tower edge).",
            "mustRequire": [
                "splicewire/laravel-beam"
            ],
            "policy": {
                "noRequire": [
                    {
                        "fromPrefix": "splicewire/laravel-beam-mcp",
                        "toPrefix": "splicewire/laravel-tower",
                        "because": "beam-mcp is reusable by any beam site; it is consumed DOWN by the tower host (SplicewireServer reads McpToolManifest) \u2014 beam-mcp never requires tower (no reverse/upward edge)"
                    },
                    {
                        "fromPrefix": "splicewire/laravel-beam-mcp",
                        "toPrefix": "splicewire/laravel-satellite",
                        "because": "the foundation never reaches up into the consumer-app tier"
                    }
                ]
            }
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-mcp-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-doctor.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-versioning.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-frame.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-schemas-scribe.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-mdx.git"
        }
    ]
}
